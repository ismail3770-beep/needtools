# ─────────────────────────────────
# NeedTools — Environment Variables
# ─────────────────────────────────

# PDF Microservices (separate deployments for better resource isolation)
NEXT_PUBLIC_PDF_EDIT_BACKEND_URL=https://your-pdf-edit-service.up.railway.app
NEXT_PUBLIC_PDF_COMPRESS_BACKEND_URL=https://your-pdf-compress-service.up.railway.app

# Optional legacy fallback: used only if the two URLs above are not set.
# NEXT_PUBLIC_BACKEND_URL=
#
# Note: a bare BACKEND_URL (without NEXT_PUBLIC_) is NOT readable in the
# browser and is therefore ignored by src/lib/pdf-backend-api.ts.

# Appwrite (database, feedback, stats, storage for PDF editor)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=replace-with-your-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=replace-with-db-id
NEXT_PUBLIC_APPWRITE_CONTACT_COL_ID=replace-with-contact-col-id
NEXT_PUBLIC_APPWRITE_FEEDBACK_COL_ID=replace-with-feedback-col-id
NEXT_PUBLIC_APPWRITE_STATS_COL_ID=replace-with-stats-col-id
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=replace-with-bucket-id
NEXT_PUBLIC_APPWRITE_SPLASH_PAGES_COL_ID=
NEXT_PUBLIC_APPWRITE_CAMPAIGNS_COL_ID=

# ─────────────────────────────────
# Cloud import pickers (ToolDropzone)
# Leave empty to hide the Google Drive / Dropbox buttons.
# ─────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_DROPBOX_APP_KEY=

# ─────────────────────────────────
# Backend-only variables (set these on Railway, not in .env.local)
# ─────────────────────────────────
# Comma-separated list of allowed CORS origins for the microservices.
# ALLOWED_ORIGINS=https://needtools.app,http://localhost:3000
# Port the microservice listens on (Railway injects this automatically).
# PORT=8002
#
# Per-IP rate limiting (both microservices). Defaults shown.
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_ENABLED=true
