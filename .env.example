# ─────────────────────────────────────────
# NeedTools — Environment Variables
# ─────────────────────────────────────────

# PDF Backend — unified service (recommended): ONE deployment powers
# edit + compress + protect + OCR + converters.
# Deploy the `backend-pdf/` folder and paste its public URL here:
NEXT_PUBLIC_PDF_BACKEND_URL=https://your-unified-pdf-service.up.railway.app

# Legacy split services — only needed if you deploy backend-pdf-edit and
# backend-pdf-compress separately instead of the unified backend-pdf/ service.
# (PdfEditorUI currently reads NEXT_PUBLIC_PDF_EDIT_BACKEND_URL directly, so
#  point it at the same unified URL until the editor is migrated.)
NEXT_PUBLIC_PDF_EDIT_BACKEND_URL=https://your-unified-pdf-service.up.railway.app
NEXT_PUBLIC_PDF_COMPRESS_BACKEND_URL=https://your-unified-pdf-service.up.railway.app

# Appwrite (database, feedback, stats, storage for PDF editor)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=replace-with-your-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=replace-with-db-id
NEXT_PUBLIC_APPWRITE_CONTACT_COL_ID=replace-with-contact-col-id
NEXT_PUBLIC_APPWRITE_FEEDBACK_COL_ID=replace-with-feedback-col-id
NEXT_PUBLIC_APPWRITE_STATS_COL_ID=replace-with-stats-col-id
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=replace-with-bucket-id
NEXT_PUBLIC_APPWRITE_SPLASH_PAGES_COL_ID=
NEXT_PUBLIC_APPWRITE_CAMPAIGNS_COL_ID=
